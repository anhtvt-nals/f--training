						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Clean Code: A Handbook of Agile Software Craftsmanship\",\n    \"author\": \"Robert C. Martin\",\n    \"categoryId\": \"cat_tech001\",\n    \"categoryName\": \"Technology\",\n    \"publishedYear\": 2008,\n    \"totalCopies\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/books",
